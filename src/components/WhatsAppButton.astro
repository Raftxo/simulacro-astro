---
const phoneNumber = '34600111222';
const message = 'Hola, me gustaría obtener más información.';
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<a
	class="whatsapp-button"
	href={whatsappUrl}
	target="_blank"
	rel="noopener noreferrer"
	aria-label="Contactar por WhatsApp"
	title="Contactar por WhatsApp"
>
	<svg viewBox="0 0 32 32" aria-hidden="true">
		<path
			d="M16 3.5a12 12 0 0 0-10.2 18.3L4.2 28l6.4-1.6A12 12 0 1 0 16 3.5Z"
			fill="none"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
		/>
		<path
			d="M11.5 10.5c.3-.7.6-.7 1-.7h.7c.2 0 .5.1.6.5l1 2.4c.1.3.1.5-.1.7l-.8 1c-.2.2-.3.4-.1.7.3.5 1 1.6 2.2 2.5 1.4 1.1 2.6 1.4 3 1.6.3.1.5.1.7-.2l1-1.2c.2-.3.5-.3.8-.2l2.2 1c.3.1.5.2.5.4 0 .3-.2 1.5-.8 2-.7.6-1.6.9-2.7.8-1.1-.1-2.5-.6-4.2-1.5-2.4-1.3-4-3.1-5.1-4.7-1-1.5-1.3-2.8-1.3-3.7 0-.8.4-1.5.8-1.9Z"
			fill="currentColor"
		/>
	</svg>
</a>

<style>
	.whatsapp-button {
		position: fixed;
		right: 1.5rem;
		bottom: 1.5rem;
		z-index: 1000;
		display: grid;
		width: 3.75rem;
		height: 3.75rem;
		place-items: center;
		border-radius: 50%;
		background: #25d366;
		color: #fff;
		box-shadow: 0 3px 12px rgb(0 0 0 / 25%);
		transition:
			background-color 0.2s ease,
			transform 0.2s ease;
	}

	.whatsapp-button:hover {
		background: #1da851;
		transform: scale(1.06);
	}

	.whatsapp-button:focus-visible {
		outline: 3px solid #128c7e;
		outline-offset: 3px;
	}

	.whatsapp-button svg {
		width: 2rem;
		height: 2rem;
	}

	@media (max-width: 480px) {
		.whatsapp-button {
			right: 1rem;
			bottom: 1rem;
		}
	}
</style>
